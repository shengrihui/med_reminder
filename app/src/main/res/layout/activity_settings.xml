<?xml version="1.0" encoding="utf-8"?>
<!-- 编辑药品页 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_card"
        app:titleTextAppearance="@style/ToolbarTitleText"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 药品名称 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etMedName"
                android:text="药品名称"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/etMedName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="20"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="20sp" />

            <!-- 每日服药安排 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="每日服药安排"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <LinearLayout
                android:id="@+id/llSchedules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnAddSchedule"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:contentDescription="添加一次服药安排"
                android:text="+ 添加一次服药"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <!-- 服用频率 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="服用频率"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnIntervalMinus"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:contentDescription="减少服用间隔天数"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/tvIntervalValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnIntervalPlus"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:contentDescription="增加服用间隔天数"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- 下一次开始日期（仅非每天时可用） -->
            <TextView
                android:id="@+id/tvStartDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="下一次开始日期"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <LinearLayout
                android:id="@+id/llStartDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvStartDateValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- 重复提醒间隔 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="未确认时重复提醒间隔"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRepeatMinus"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:contentDescription="减少重复提醒间隔"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/tvRepeatValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <Button
                    android:id="@+id/btnRepeatPlus"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:contentDescription="增加重复提醒间隔"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- 保存按钮 -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:text="保存设置"
                android:textSize="19sp"
                app:cornerRadius="14dp" />

            <!-- 删除按钮 -->
            <Button
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:contentDescription="删除此药品"
                android:text="删除此药品"
                android:textColor="@color/status_not_taken"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
